diff --git a/drivers/gpu/drm/virtio/virtgpu_plane.c b/drivers/gpu/drm/virtio/virtgpu_plane.c
index 1d1b27ece..a9c20fca7 100644
--- a/drivers/gpu/drm/virtio/virtgpu_plane.c
+++ b/drivers/gpu/drm/virtio/virtgpu_plane.c
@@ -36,8 +36,23 @@
 
 static const uint32_t virtio_gpu_formats[] = {
 	DRM_FORMAT_HOST_XRGB8888,
+	/*
+	 * With virgl the host shows a 3D resource in the format it was created
+	 * with; the framebuffer format only has to be accepted. Android's
+	 * SurfaceFlinger renders its client target in RGBA (ABGR8888).
+	 */
+	DRM_FORMAT_ABGR8888,
+	DRM_FORMAT_XBGR8888,
 };
 
+bool virtio_gpu_is_scanout_format(struct virtio_gpu_device *vgdev, u32 format)
+{
+	if (format == DRM_FORMAT_HOST_XRGB8888 || format == DRM_FORMAT_HOST_ARGB8888)
+		return true;
+	return vgdev->has_virgl_3d &&
+	       (format == DRM_FORMAT_ABGR8888 || format == DRM_FORMAT_XBGR8888);
+}
+
 static const uint32_t virtio_gpu_cursor_formats[] = {
 	DRM_FORMAT_HOST_ARGB8888,
 };
