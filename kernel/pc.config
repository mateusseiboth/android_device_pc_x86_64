# PC kernel: applied after Fedora's config and Android's android-base.config.
CONFIG_LOCALVERSION="-lineage-pc"
# CONFIG_LOCALVERSION_AUTO is not set

# Secure Boot: with it on, IMA's architecture policy makes the kernel refuse unsigned modules, and ueventd
# loads every driver from /vendor/lib/modules. modules_install signs each module with the builder's key
# (CONFIG_MODULE_SIG_KEY, set by build_kernel.sh from PC_SECUREBOOT_KEYS), whose certificate the kernel
# embeds. Without Secure Boot unsigned modules still load (no SIG_FORCE).
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_LSM="selinux"

# Smaller and faster to build; nothing on the device reads debug info.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set

# Android's cgroups.json mounts cpuset as a cgroup v1 hierarchy (/dev/cpuset); without it init's
# SetupCgroups fails and no service can start.
CONFIG_CPUSETS_V1=y

# Needed before any module can load: the initrd finds the install folder on these.
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_BLOCK=y
CONFIG_RPMB=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_BTRFS_FS=y
# The old ntfs driver caps NTFS3 at =m (NTFS3 depends on !NTFS_FS || m).
# CONFIG_NTFS_FS is not set
CONFIG_NTFS3_FS=y
CONFIG_EXFAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EROFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Screen from the first line: the firmware framebuffer until the GPU driver loads.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y

CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Android's netd uses the legacy iptables, a separate option since 6.17.
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_NF_TPROXY_IPV4=y
CONFIG_NF_TPROXY_IPV6=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_LEDS_CLASS_MULTICOLOR=y

# Android wants full preemption (Fedora uses lazy).
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_LAZY is not set
# CONFIG_PREEMPT_VOLUNTARY is not set

# Linux terminal (AVF): crosvm runs the Debian VM on KVM, without pKVM. Built in, so /dev/kvm exists
# from the start whenever VT-x/AMD-V is enabled in the firmware (pc-hypervisor.sh reads that). vhost-vsock
# and AF_VSOCK carry virtmgr's channels to the guest; TUN and the bridge serve its network (vmnic).
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_VHOST=y
CONFIG_VHOST_VSOCK=y
CONFIG_VSOCKETS=y
CONFIG_VSOCKETS_LOOPBACK=y
CONFIG_VSOCKETS_DIAG=y
CONFIG_TUN=y
CONFIG_BRIDGE=y

# ARM apps (libndk_translation): ARM executables run through binfmt_misc, which nothing would load as
# a module before the native bridge registers its handlers.
CONFIG_BINFMT_MISC=y

# Fedora's /usr/bin/modprobe does not exist here: request_module() (iwlwifi's op modes, Intel sound's
# machine drivers, filesystems, crypto) goes through our script instead (rootdir/pc-modprobe.sh).
CONFIG_MODPROBE_PATH="/vendor/bin/pc-modprobe.sh"
# android-base.config makes every kernel helper go through one fixed program; ours is the module loader
# (the script refuses any other call). Its default, /sbin/usermode-helper, does not exist here.
CONFIG_STATIC_USERMODEHELPER_PATH="/vendor/bin/pc-modprobe.sh"
# The PC speaker as a sound card takes card 0 on some PCs (Surface Go 2), the only card Android's audio
# HAL plays on; it only beeps.
# CONFIG_SND_PCSP is not set
