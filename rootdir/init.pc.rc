# LineageOS for PCs (androidboot.hardware=pc).

on early-init
    # init.rc clears the kernel's module loader; drivers that load helpers by name need it back
    # (iwlwifi's iwlmvm, which makes wlan0, and Intel sound's machine drivers).
    write /proc/sys/kernel/modprobe /vendor/bin/pc-modprobe.sh

on fs
    # pc-init (the initrd) mounted the system and /data before Android started; there is nothing left
    # for fs_mgr to mount and /data is not encrypted.
    setprop ro.crypto.state unsupported
    # What mount_all queues on an unencrypted /data: init.rc starts class main and late_start on it.
    trigger nonencrypted

# Linux terminal (AVF): non-protected VMs on KVM, when VT-x/AMD-V is enabled (pc-hypervisor.sh). An
# androidboot.hypervisor.* argument on the kernel command line is set first and wins.
on post-fs
    setprop ro.boot.hypervisor.protected_vm.supported false
    exec_start pc-hypervisor

on property:vendor.pc.kvm=true
    setprop ro.boot.hypervisor.vm.supported true
    setprop hypervisor.memory_reclaim.supported true

# Inside a VM the screen stays on: QEMU's virtio-gpu does not come back from suspend, and the screen
# would freeze once Android slept after the screen timeout.
on property:sys.boot_completed=1 && property:vendor.pc.guest=true
    exec - system system -- /system/bin/svc power stayon true

service pc-hypervisor /vendor/bin/pc-hypervisor.sh
    user system
    group system
    oneshot
    disabled

# Wi-Fi without a vendor HAL: the framework starts the supplicant on wlan0 (nl80211).
service wpa_supplicant /vendor/bin/hw/wpa_supplicant -iwlan0 -Dnl80211 \
        -c/vendor/etc/wifi/wpa_supplicant.conf -O/data/vendor/wifi/wpa/sockets -dd -g@android:wpa_wlan0
    interface aidl android.hardware.wifi.supplicant.ISupplicant/default
    socket wpa_wlan0 dgram 660 wifi wifi
    user wifi
    group system wifi inet keystore
    capabilities NET_ADMIN NET_RAW
    oneshot
    disabled

on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    exec - root root -- /system/bin/sh /vendor/bin/pc-bootlog.sh /metadata/pc-logs
    start pc_bootlog

# Logs of every boot in the install folder (metadata/pc-logs, readable from the PC's other system): all
# buffers, kernel included, from early on, so a boot that never reaches the screen is logged too. 4 MB a
# file, 4 files a boot, the last three boots (pc-bootlog.sh).
service pc_bootlog /system/bin/logcat -b all -v threadtime -f /metadata/pc-logs/boot-1/logcat.txt -r 4096 -n 3
    user root
    group root log
    oneshot
    disabled

# Debug (androidboot.pc.adb=1, the GRUB "adb over network" entry): adb on TCP 5555 from boot, for a PC
# without serial port. Set before AdbService starts, so it reads adb as on; the person still approves
# the computer's key on screen.
on post-fs-data && property:ro.boot.pc.adb=1
    setprop persist.sys.usb.config adb
    setprop service.adb.tcp.port 5555
