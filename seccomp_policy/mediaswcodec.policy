# Added to the media.swcodec APEX's own policy (main_swcodecservice.cpp reads this file too).
# A decoder writing to a surface allocates graphic buffers through minigbm's gbm_mesa backend, which
# loads Mesa's Gallium driver into this process. Mesa sizes its thread pools from the CPU affinity
# and checks whether two DRM fds are the same file; without these calls the decoder died with SIGSYS
# (arm64 apps through libndk_translation could not play any video).
sched_getaffinity: 1
sched_setaffinity: 1
kcmp: 1
fcntl: 1
dup3: 1
getdents64: 1
getrandom: 1
sysinfo: 1
eventfd2: 1
pipe2: 1
rt_sigprocmask: 1
prlimit64: 1
getpriority: 1
sched_getparam: 1
sched_getscheduler: 1
membarrier: 1
mincore: 1
statx: 1
ppoll: 1
geteuid: 1
getegid: 1
getgid: 1
